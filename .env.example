# PAYRECORD — Plantilla de variables de entorno
# Copiar este archivo como .env y rellenar los valores.
# El archivo .env NUNCA se sube al repositorio (§28).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# DB_ENGINE admite: mysql | sqlite
DB_ENGINE=mysql
DB_NAME=payrecord
DB_USER=payrecord
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Correo ---
# En desarrollo se usa el backend de consola: los correos se imprimen en la
# terminal, no se envían de verdad. Para enviar correos reales (recordatorios
# por correo, recuperación de contraseña) cambiar EMAIL_BACKEND a
# django.core.mail.backends.smtp.EmailBackend y completar EMAIL_HOST,
# EMAIL_HOST_USER y EMAIL_HOST_PASSWORD. Con Gmail: EMAIL_HOST=smtp.gmail.com,
# EMAIL_PORT=587, EMAIL_USE_TLS=True, y una "contraseña de aplicación" (no la
# contraseña normal de la cuenta) como EMAIL_HOST_PASSWORD.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-responder@payrecord.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Tarea diaria (periodos mensuales + recordatorios) ---
# Solo hace falta en producción: protege el endpoint que llama el workflow
# programado de GitHub Actions una vez al día (ver docs/despliegue-azure.md,
# §10). Vacío = el endpoint queda desactivado. Generar uno largo y distinto
# por entorno, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TAREA_DIARIA_TOKEN=

# --- Reglas de negocio ---
# Días por defecto para considerar una obligación "próxima a vencer" (§9)
DIAS_PROXIMO_VENCIMIENTO_DEFAULT=7

# --- Asistente IA (PayRecord AI) ---
# Clave gratuita de la API de Gemini: https://aistudio.google.com/apikey
# Vacío = el asistente aparece desactivado en la interfaz, el resto de la
# aplicación funciona igual sin esto.
GEMINI_API_KEY=
# Modelo de Gemini. "gemini-flash-lite-latest" es un alias que Google
# mantiene apuntando siempre al modelo Flash-Lite gratuito vigente (no hay
# que actualizarlo a mano cuando Google saque una versión nueva). Se eligió
# Lite y no "gemini-flash-latest" porque, probado en vivo, Lite respondió
# 3/3 veces en <1s mientras el Flash normal fallaba por saturación del
# nivel gratuito (cambiar aquí si eso cambia).
GEMINI_MODEL=gemini-flash-lite-latest
