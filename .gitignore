# --- Secretos: NUNCA versionar (§28) ---
.env
*.env
!.env.example
# Versiones de los scripts SQL con contraseñas ya sustituidas
*.local.sql
# Respaldos de la base de datos: contienen datos y hashes de contraseñas
*_respaldo.sql
*.dump.sql

# --- Entorno virtual ---
.venv/
venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# --- Django ---
*.log
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/

